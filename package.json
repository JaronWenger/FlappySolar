{
  "name": "flappy-solar",
  "version": "1.0.0",
  "description": "A space-themed Flappy Bird game",
  "main": "server.js",
  "homepage": "https://jaronwenger.github.io/FlappySolar/",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stop": "pkill -f 'node server.js'",
    "predeploy": "npm run build",
    "build": "echo 'No build step needed'",
    "deploy": "gh-pages -d .",
    "fix-gh-pages": "node check-gh-pages.js",
    "upload-images": "node upload-images.js"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "gh-pages": "^6.1.1"
  }
}
